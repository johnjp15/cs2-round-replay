{
  "name": "cs2-round-replay",
  "version": "0.1.0",
  "private": true,
  "description": "Browser 2D top-down replay of a CS2 Mirage round: one human player, nine bots on recorded paths.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:3d": "vite --config vite.3d.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "build:3d": "tsc --noEmit && vite build --config vite.3d.config.ts",
    "build:single:3d": "tsc --noEmit && vite build --config vite.single.3d.config.ts",
    "preview": "vite preview",
    "preview:3d": "vite preview --config vite.3d.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "extract:round": "tsx tools/extract-round.ts",
    "validate:round": "tsx tools/validate-round.ts",
    "extract:nav": "tsx tools/extract-nav.ts",
    "bench:session": "tsx tools/bench-session.ts",
    "check:browser": "tsx tools/browser-check.ts",
    "check:browser:3d": "tsx tools/browser-check3d.ts",
    "bench:3d": "tsx tools/bench-app3d.ts",
    "ghost": "tsx tools/ghost-round.ts",
    "scripted": "tsx tools/scripted-round.ts",
    "harness": "tsx tools/harness.ts",
    "fixtures:update": "tsx tools/golden-fixtures.ts",
    "extract:vismask": "tsx tools/extract-vismask.ts",
    "geometry:extract": "tsx tools/extract-geometry.ts",
    "clips:extract": "tsx tools/extract-clips.ts",
    "tracks:snap": "tsx tools/snap-tracks.ts",
    "vision": "tsx tools/vision-labels.ts",
    "stage:web-apps": "bash tools/stage-web-apps.sh",
    "check:locked": "tsx tools/e2e-locked.ts",
    "parity": "tsx tools/video-parity.ts",
    "parity:2d": "npm run build && tsx tools/video-parity.ts --app 2d --times \"every 0.5\" --runs watch,follow --out logs/parity-2d --baseline docs/parity/baseline-2d.json",
    "parity:3d": "npm run build:3d && tsx tools/video-parity.ts --app 3d --times \"every 0.5\" --runs watch --out logs/parity-3d --baseline docs/parity/baseline-3d.json",
    "harness3d": "tsx tools/harness3d.ts",
    "test:e2e:spray": "tsx tools/e2e/spray.ts",
    "test:e2e:weapons": "tsx tools/e2e/weapons.ts",
    "test:e2e:movement": "tsx tools/e2e/movement.ts",
    "test:e2e:grenades": "tsx tools/e2e/grenades.ts",
    "test:e2e:round": "tsx tools/e2e/round.ts",
    "test:e2e": "npm run test:e2e:round && npm run test:e2e:movement && npm run test:e2e:weapons && npm run test:e2e:grenades && npm run test:e2e:spray"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnjp15/cs2-round-replay.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.14.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
