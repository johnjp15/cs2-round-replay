{
  "name": "cs2-round-replay",
  "version": "0.1.0",
  "private": true,
  "description": "Browser 2D top-down replay of a CS2 Mirage round: one human player, nine bots on recorded paths.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "extract:round": "tsx tools/extract-round.ts",
    "validate:round": "tsx tools/validate-round.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnjp15/cs2-round-replay.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
